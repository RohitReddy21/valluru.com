# Copy this file to .env.local and fill in real values.
# Never commit real keys — .env and *.local are gitignored, this file is not.

# --- Supabase (browser, safe to expose) ---------------------------------
# Anon key is public by design; row level security decides what it can read.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server only, NEVER expose to the browser) ----------------
# Used by /api/resources. Bypasses row level security entirely.
# Set these in Vercel -> Project -> Settings -> Environment Variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin ---------------------------------------------------------------
# Password required by /api/site-content and /api/resources for any write.
ADMIN_PASSWORD=choose-a-strong-password

# --- Upstash Redis (live site content) -----------------------------------
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Optional ------------------------------------------------------------
VITE_IMAGE_OPTIMIZATION_URL=
